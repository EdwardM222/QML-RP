	langid = {english},
	file = {PDF:C\:\\Users\\edwar\\Zotero\\storage\\3TV433BJ\\Demi̇R and Dalkiliç - 2018 - Modified stacking ensemble approach to detect network intrusion.pdf:application/pdf},
}

@article{mcfarthing_classical_2024,
	title = {Classical ensembles of single-qubit quantum variational circuits for classification},
	volume = {6},
	issn = {2524-4914},
	url = {https://doi.org/10.1007/s42484-024-00211-x},
	doi = {10.1007/s42484-024-00211-x},
	abstract = {The quantum asymptotically universal multi-feature ({QAUM}) encoding architecture was recently introduced and showed improved expressivity and performance in classifying pulsar stars. The circuit uses generalized trainable layers of parameterized single-qubit rotation gates and single-qubit feature encoding gates. Although the improvement in classification accuracy is promising, the single-qubit nature of this architecture, combined with the circuit depth required for accuracy, limits its applications on {NISQ} devices due to their low coherence times. This work reports on the design, implementation, and evaluation of ensembles of single-qubit {QAUM} classifiers using classical bagging and boosting techniques. We demonstrate an improvement in validation accuracy for pulsar star classification. We find that this improvement is not dataset specific as we observe consistent improvements for the {MNIST} Digits and Wisconsin Cancer datasets. We also observe that the boosting ensemble achieves an acceptable level of accuracy with only a small amount of training, while the bagging ensemble achieves higher overall accuracy with ample training time. This shows that classical ensembles of single-qubit circuits present a new approach for certain classification problems.},
	pages = {81},
	number = {2},
	journaltitle = {Quantum Machine Intelligence},
	shortjournal = {Quantum Mach. Intell.},
	author = {{McFarthing}, Shane and Pillay, Anban and Sinayskiy, Ilya and Petruccione, Francesco},
	urldate = {2026-05-28},
	date = {2024-11-16},
	langid = {english},
	keywords = {Classical ensembles, Machine learning, Quantum classifiers, Quantum computing},
	file = {Full Text PDF:C\:\\Users\\edwar\\Zotero\\storage\\E3EYHRND\\McFarthing et al. - 2024 - Classical ensembles of single-qubit quantum variational circuits for classification.pdf:application/pdf},
}

@inproceedings{liu_construction_2025,
	title = {Construction of Weak Classifiers and Optimized Implementation of {QBoost} Ensemble Model},
	url = {https://ieeexplore.ieee.org/abstract/document/11283264},
	doi = {10.1109/EIECS67708.2025.11283264},
	abstract = {{QBoost}, a quantum-inspired ensemble learning algorithm, has performance that depends on the quality of weak classifiers and efficiency of the optimization process. Existing methods suffer from insufficient diversity among weak classifiers and low efficiency in handling nonlinear data patterns, leading to unsatisfactory generalization ability. This study proposes a new weak classifier construction method based on pruned random decision trees-combined with a multi-objective optimized {QBoost} model-to fix these problems. Weak classifiers are constructed using random subspaces with adaptive tree pruning; this enhances diversity while cutting overfitting. For {QBoost}, the study introduces a multi-objective optimization framework to minimize classification loss and maximize weak classifier diversity at the same time, and uses an improved {AdamW} algorithm to speed up convergence. Experiments on {KDD} Cup 99, {IMDb}, and Covertype datasets show the proposed method hits 96.8 \% classification accuracy on {KDD} Cup 99- {\textbackslash}mathbf3. 3 \% higher than Gradient Boosting (93.5 \%) and 2.6 \% higher than standard {QBoost} (94.2 \%). Compared with standard {QBoost}, its training time drops by 37 \%, and it keeps 89.7 \% accuracy under 15 \% feature noise-proving better robustness. These findings confirm the proposed method effectively improves classification performance, efficiency, and diversity.},
	eventtitle = {2025 5th International Conference on Electronic Information Engineering and Computer Science ({EIECS})},
	pages = {498--502},
	booktitle = {2025 5th International Conference on Electronic Information Engineering and Computer Science ({EIECS})},
	author = {Liu, Jiarui and Wu, Xiaoxin and Liao, Yiwei and Peng, Hui},
	urldate = {2026-05-28},
	date = {2025-09},
	keywords = {Accuracy, {AdamW}, Boosting, Classification algorithms, Classifier diversity, Decision trees, Ensemble learning, Multi-objective optimization, Optimization, Overfitting, {QBoost}, Random decision tree, Standards, Training, Tuning, Weak classifier},
	file = {Full Text PDF:C\:\\Users\\edwar\\Zotero\\storage\\KDA5REYR\\Liu et al. - 2025 - Construction of Weak Classifiers and Optimized Implementation of QBoost Ensemble Model.pdf:application/pdf},
}

@article{akrom_bloodbrain_2025,
	title = {Blood–brain barrier permeability prediction via novel stacking classical-quantum hybrid model},
	volume = {36},
	issn = {2468-1113},
	url = {https://www.sciencedirect.com/science/article/pii/S2468111325000489},
	doi = {10.1016/j.comtox.2025.100388},
	abstract = {The blood–brain barrier plays a critical role in maintaining the stability of the central nervous system, yet it also limits drug delivery. Existing machine learning ({ML}) and deep learning ({DL}) approaches for predicting blood–brain barrier permeability ({BBBP}) often face challenges such as class imbalance, scalability, and high computational demands. To address these limitations, this study aims to develop a novel Stacking Ensemble–Quantum Support Vector Machine ({SEQSVM}) model that integrates classical ensemble learners ({AdaBoost}, {XGBoost}, and {CatBoost}) with a quantum meta-learner ({QSVM}). The proposed hybrid model incorporates {SMOTE} + Tomek for effectively handling class imbalance and a customized quantum feature map for molecular fingerprint encoding. Experimental results on two benchmark {BBBP} datasets demonstrate that {SEQSVM} achieves 95.0 \% accuracy on D1 (1970 samples) and 92.0 \% on D2 (8153 samples), consistently outperforming classical ensemble models by 3–6 \% in accuracy, sensitivity, and specificity. Compared to existing {ML} and {DL} models, {SEQSVM} offers a superior balance between accuracy, interpretability, and computational efficiency. It is a promising approach for {BBBP} prediction in real-world drug discovery applications.},
	pages = {100388},
	journaltitle = {Computational Toxicology},
	shortjournal = {Computational Toxicology},
	author = {Akrom, Muhamad and Rustad, Supriadi and Sutojo, Totok and Ignatius Moses Setiadi, De Rosal and Dipojono, Hermawan Kresno and Maezono, Ryo and Kasai, Hideaki},
	urldate = {2026-05-28},
	date = {2025-12-01},
	keywords = {Binary classification, Blood–brain barrier permeability, Hybrid model, Quantum support vector machine},
	file = {PDF:C\:\\Users\\edwar\\Zotero\\storage\\4XF3BZ4X\\Akrom et al. - 2025 - Blood–brain barrier permeability prediction via novel stacking classical-quantum hybrid model.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\edwar\\Zotero\\storage\\UDQZWRQN\\S2468111325000489.html:text/html},
}

@article{safina_quantum_2023,
